{
  "uid": "vig-operations",
  "title": "Verified inference operations",
  "schemaVersion": 39,
  "tags": [
    "vig"
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "source",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Observation coverage",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${source}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${source}"
          },
          "expr": "vig_observation_coverage",
          "legendFormat": "{{service}} · {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No observation"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Sampling state",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${source}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${source}"
          },
          "expr": "vig_sampling_coverage == 1",
          "legendFormat": "{{state}} · {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No observation"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Engine startup gate failures",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${source}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${source}"
          },
          "expr": "vig_engine_startup_gate_failed",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No observation"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Unwarranted engine requests",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${source}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${source}"
          },
          "expr": "sum by (job,instance,mode) (increase(vig_unwarranted_total{service=\"engine\"}[1h])) / sum by (job,instance,mode) (increase(vig_engine_requests_total{service=\"engine\"}[1h]))",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "No observation"
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Beacon availability",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${source}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${source}"
          },
          "expr": "vig_beacon_available",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No observation"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "Authenticated beacon lag",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${source}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${source}"
          },
          "expr": "vig_beacon_lag_seconds",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No observation"
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "Signed deviations in the last five minutes",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${source}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${source}"
          },
          "expr": "vig_signed_deviations_last_5m",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No observation"
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "title": "Verified log size",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${source}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${source}"
          },
          "expr": "vig_log_tree_size",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No observation"
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "title": "Recorded log incidents",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${source}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${source}"
          },
          "expr": "sum by (instance,kind) (vig_log_incidents_total)",
          "legendFormat": "{{kind}} · {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No observation"
        },
        "overrides": []
      }
    }
  ]
}
