[Unit]
Description=Expire private verified inference state (%i)
After=vig@%i.service

[Service]
User=vig-%i
Group=vig-%i
UMask=0077
WorkingDirectory=/opt/vig/source
StateDirectory=vig-%i
StateDirectoryMode=0700
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateNetwork=yes
PrivateTmp=yes
EnvironmentFile=/etc/vig/retention-%i.conf
ExecStart=/opt/vig/venv/bin/python -E -s -m operations.retention --interval-seconds ${VIG_RETENTION_INTERVAL_SECONDS} %i $VIG_RETENTION_PATHS
Restart=on-failure

[Install]
WantedBy=multi-user.target
