{
  "name": "akashi-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler d1 migrations apply akashi --local && wrangler dev --test-scheduled",
    "deploy": "wrangler d1 migrations apply akashi --remote && wrangler deploy",
    "check": "wrangler types && tsc && vitest run",
    "types": "wrangler types"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.9.2",
    "typescript": "5.9.3",
    "vitest": "4.1.5",
    "wrangler": "4.168.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true,
    "workerd@1.20260815.1": true,
    "workerd@1.20261123.1": true,
    "fsevents": false
  }
}
