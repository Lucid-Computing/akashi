{
  "$description": "Taste tokens as data, for people on other stacks. The same values as taste/tokens.css; the CSS name of each token is in $css. A theme fills the five values of the accent slot; every other value is fixed. Values given with 'clamp(...)' are fluid CSS; 'phone', 'tablet' and 'wide' give the values below 701px, from 701px, and from 1181px.",
  "ground": {
    "night": { "$type": "color", "$value": "#07080c", "$css": "--ground-night", "$description": "The dark ground." },
    "paper": { "$type": "color", "$value": "#f3f4f0", "$css": "--ground-paper", "$description": "The light ground, the default." },
    "white": { "$type": "color", "$value": "#ffffff", "$css": "--ground-white", "$description": "Panels laid on paper." },
    "night-panel": { "$type": "color", "$value": "#111218", "$css": "--ground-night-panel", "$description": "Panels laid on night." }
  },
  "ink": {
    "paper": { "$type": "color", "$value": "#07080c", "$css": "--ink", "$description": "Text and solid marks on paper." },
    "night": { "$type": "color", "$value": "#ffffff", "$css": "--ink-night", "$description": "Text and solid marks on night." }
  },
  "accent": {
    "$description": "The accent slot. The defaults are a neutral that works alone. A theme sets all five.",
    "accent": { "$type": "color", "$value": "#07080c", "$css": "--accent", "$description": "The one colour: fills, and marks on paper. Must read on paper: 4.5:1 or more against #f3f4f0, since it is used as text." },
    "on-accent": { "$type": "color", "$value": "#ffffff", "$css": "--on-accent", "$description": "Text and marks on an accent fill." },
    "accent-light": { "$type": "color", "$value": "#ffffff", "$css": "--accent-light", "$description": "The accent as light on night: waves, live marks. Must read on night." },
    "accent-night": { "$type": "color", "$value": "#ffffff", "$css": "--accent-night", "$description": "The accent as a fill on night (a pressed button)." },
    "on-accent-night": { "$type": "color", "$value": "#07080c", "$css": "--on-accent-night", "$description": "Text on that fill." }
  },
  "mist": {
    "paper": { "$type": "color", "$value": "#686e88", "$css": "--mist", "$description": "Labels on paper and white." },
    "night": { "$type": "color", "$value": "#8a8d97", "$css": "--mist-night", "$description": "Labels on night." },
    "accent": { "$type": "color", "$value": "color-mix(in srgb, on-accent 82%, accent)", "$css": "--mist-accent", "$description": "Labels on an accent ground, derived from the accent." }
  },
  "line": {
    "paper": { "$type": "color", "$value": "#07080c26", "$css": "--line", "$description": "Hairline on paper (ink at 15%)." },
    "night": { "$type": "color", "$value": "#ffffff26", "$css": "--line-night", "$description": "Hairline on night (white at 15%)." },
    "accent": { "$type": "color", "$value": "color-mix(in srgb, on-accent 32%, transparent)", "$css": "--line-accent", "$description": "Hairline on an accent ground." },
    "tag-paper": { "$type": "color", "$value": "#07080c45", "$css": "--line-tag", "$description": "The edge of a tag on paper." },
    "tag-night": { "$type": "color", "$value": "#ffffff4d", "$css": "--line-tag-night", "$description": "The edge of a tag on night." }
  },
  "cipher": {
    "paper": { "$type": "color", "$value": "#6b718b", "$css": "--cipher-paper", "$description": "Cipher characters in figures on paper." },
    "dim-paper": { "$type": "color", "$value": "#a3a7b8", "$css": "--cipher-dim-paper", "$description": "Faint cipher on paper." },
    "night": { "$type": "color", "$value": "#98a0c4", "$css": "--cipher-night", "$description": "Cipher characters on night." },
    "dim-night": { "$type": "color", "$value": "#4d536b", "$css": "--cipher-dim-night", "$description": "Faint cipher on night." },
    "accent": { "$type": "color", "$value": "color-mix(in srgb, on-accent 78%, accent)", "$css": "--cipher-accent", "$description": "Cipher characters on an accent ground." },
    "dim-accent": { "$type": "color", "$value": "color-mix(in srgb, on-accent 45%, accent)", "$css": "--cipher-dim-accent", "$description": "Faint cipher on an accent ground." }
  },
  "font": {
    "sans": { "$type": "fontFamily", "$value": ["Geist", "system-ui", "-apple-system", "Segoe UI", "Roboto", "sans-serif"], "$css": "--font-sans", "$description": "Geist. Semibold capitals for claims, Regular for sentences." },
    "mono": { "$type": "fontFamily", "$value": ["Geist Mono", "ui-monospace", "SF Mono", "Menlo", "Consolas", "monospace"], "$css": "--font-mono", "$description": "Geist Mono. Labels and facts: values, hashes, numbers, tags." },
    "weight-regular": { "$type": "fontWeight", "$value": 400, "$css": "--weight-regular" },
    "weight-claim": { "$type": "fontWeight", "$value": 600, "$css": "--weight-claim" }
  },
  "type": {
    "claim": { "$type": "typography", "$value": { "fontFamily": "sans", "fontWeight": 600, "fontSize": "clamp(40px, 6.5vw, 104px)", "lineHeight": 0.9, "letterSpacing": "-0.042em", "textTransform": "uppercase" }, "$css": "--size-claim --leading-claim --track-claim", "$description": "The one claim of a screen. Class .xl." },
    "headline": { "$type": "typography", "$value": { "fontFamily": "sans", "fontWeight": 600, "fontSize": "clamp(28px, 3.1vw, 46px)", "lineHeight": 0.95, "letterSpacing": "-0.035em", "textTransform": "uppercase" }, "$css": "--size-headline --leading-headline --track-headline", "$description": "A smaller headline. Class .tt." },
    "lead": { "$type": "typography", "$value": { "fontFamily": "sans", "fontWeight": 400, "fontSize": "clamp(22px, 2.3vw, 38px)", "lineHeight": 1.15, "letterSpacing": "-0.025em" }, "$css": "--size-lead --leading-lead --track-lead", "$description": "A large sentence. Class .lead." },
    "sentence": { "$type": "typography", "$value": { "fontFamily": "sans", "fontWeight": 400, "fontSize": "clamp(18px, 1.5vw, 23px)", "lineHeight": 1.3, "letterSpacing": "-0.015em" }, "$css": "--size-sentence --leading-sentence --track-sentence", "$description": "A sentence that carries meaning. Class .sent." },
    "body": { "$type": "typography", "$value": { "fontFamily": "sans", "fontWeight": 400, "fontSize": "16px", "lineHeight": 1.45, "letterSpacing": "-0.01em" }, "$css": "--size-body --leading-body --track-body", "$description": "Running text and controls." },
    "value": { "$type": "typography", "$value": { "fontFamily": "mono", "fontWeight": 400, "fontSize": "clamp(22px, 3.15vw, 56px)", "lineHeight": 1, "letterSpacing": "0", "textTransform": "uppercase" }, "$css": "--size-value", "$description": "A fact shown large. Class .val." },
    "label": { "$type": "typography", "$value": { "fontFamily": "mono", "fontWeight": 400, "fontSize": "11px", "lineHeight": "16px", "letterSpacing": "0.07em", "textTransform": "uppercase" }, "$css": "--size-label --leading-label --track-label", "$description": "Labels and facts. Class .mono." },
    "button": { "$type": "typography", "$value": { "fontFamily": "mono", "fontWeight": 400, "fontSize": "12px", "lineHeight": 1, "letterSpacing": "0.07em", "textTransform": "uppercase" }, "$css": "--size-button", "$description": "Button labels." },
    "code": { "$type": "typography", "$value": { "fontFamily": "mono", "fontWeight": 400, "fontSize": "13px", "lineHeight": 1.55, "letterSpacing": "0" }, "$css": "--size-code", "$description": "Code blocks." }
  },
  "space": {
    "1": { "$type": "dimension", "$value": "4px", "$css": "--space-1" },
    "2": { "$type": "dimension", "$value": "8px", "$css": "--space-2" },
    "3": { "$type": "dimension", "$value": "12px", "$css": "--space-3" },
    "4": { "$type": "dimension", "$value": "16px", "$css": "--space-4" },
    "5": { "$type": "dimension", "$value": "24px", "$css": "--space-5" },
    "6": { "$type": "dimension", "$value": "32px", "$css": "--space-6" },
    "7": { "$type": "dimension", "$value": "48px", "$css": "--space-7" },
    "8": { "$type": "dimension", "$value": "clamp(56px, 6vw, 96px)", "$css": "--space-8" },
    "9": { "$type": "dimension", "$value": "clamp(72px, 8vw, 136px)", "$css": "--space-9" },
    "top": { "$type": "dimension", "$value": "clamp(48px, 6.5vw, 100px)", "$css": "--space-top", "$description": "From a part's top edge to its label line." },
    "end": { "$type": "dimension", "$value": "clamp(96px, 11vw, 168px)", "$css": "--space-end", "$description": "Clear ground under a part's last line." }
  },
  "radius": {
    "sheet": { "$type": "dimension", "$value": "clamp(26px, 4vw, 56px)", "$css": "--radius-sheet", "$description": "The soft corner of a sheet laid over another ground." },
    "box": { "$type": "dimension", "$value": "14%", "$css": "--radius-box", "$description": "A square figure: 14 on 100." },
    "panel": { "$type": "dimension", "$value": "14px", "$css": "--radius-panel" },
    "control": { "$type": "dimension", "$value": "7px", "$css": "--radius-control", "$description": "Buttons and inputs." },
    "tag": { "$type": "dimension", "$value": "4px", "$css": "--radius-tag" }
  },
  "grid": {
    "max": { "$type": "dimension", "$value": "1560px", "$css": "--grid-max" },
    "gutter": { "$type": "dimension", "$value": "clamp(16px, 2.4vw, 36px)", "$css": "--grid-gutter", "$description": "Page edge to content." },
    "margin": { "$type": "dimension", "$value": { "phone": "0px", "tablet": "132px", "wide": "188px" }, "$css": "--grid-margin", "$description": "The margin column for numbers and labels. On phones it folds into one line above each block." },
    "gap": { "$type": "dimension", "$value": { "phone": "20px", "tablet": "28px", "wide": "40px" }, "$css": "--grid-gap" },
    "label": { "$type": "dimension", "$value": { "phone": "168px", "tablet": "168px", "wide": "216px" }, "$css": "--grid-label", "$description": "A label track inside the main column." },
    "value": { "$type": "dimension", "$value": { "phone": "200px", "tablet": "200px", "wide": "248px" }, "$css": "--grid-value", "$description": "A value track inside the main column." },
    "rail": { "$type": "dimension", "$value": "52px", "$css": "--grid-rail", "$description": "The running head inside the margin column (wide only)." },
    "breakpoints": { "$type": "dimension", "$value": { "tablet": "701px", "wide": "1181px" } }
  },
  "motion": {
    "ease": { "$type": "cubicBezier", "$value": [0.3, 0.6, 0.2, 1], "$css": "--ease" },
    "quick": { "$type": "duration", "$value": "200ms", "$css": "--dur-quick", "$description": "Colour changes on hover and focus." },
    "reveal": { "$type": "duration", "$value": "1300ms", "$css": "--dur-reveal", "$description": "A heading crossed by a pass of light." },
    "cipher-step": { "$type": "duration", "$value": "46ms", "$css": "--cipher-step", "$description": "One step of text through the cipher." }
  }
}
